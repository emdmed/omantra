{
  "schemaVersion": 1,
  "id": "io.github.emdmed.omantra",
  "name": "Omantra",
  "version": "1.0.0",
  "author": "emdmed",
  "license": "MIT",
  "description": "Speak to your desktop. Local speech-to-text, interpreted by a local LLM into desktop actions.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Omantra",
    "description": "Double-tap Super to speak a command; left click to dictate to the clipboard.",
    "category": "Audio",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "transcribeCommand": "",
      "interpreterCommand": "",
      "threads": 6,
      "maxSeconds": 300,
      "copyToClipboard": true,
      "typeOut": false,
      "notify": true,
      "overlay": true
    },
    "schema": [
      {
        "key": "transcribeCommand",
        "type": "string",
        "label": "Transcribe command (blank = bundled)",
        "defaultValue": ""
      },
      {
        "key": "interpreterCommand",
        "type": "string",
        "label": "Interpreter for command mode (blank = bundled)",
        "defaultValue": ""
      },
      {
        "key": "threads",
        "type": "integer",
        "label": "Decoder threads",
        "min": 1,
        "max": 12,
        "step": 1,
        "defaultValue": 6
      },
      {
        "key": "maxSeconds",
        "type": "integer",
        "label": "Max recording length (seconds)",
        "min": 10,
        "max": 3600,
        "step": 10,
        "defaultValue": 300
      },
      {
        "key": "copyToClipboard",
        "type": "boolean",
        "label": "Copy transcript to clipboard",
        "defaultValue": true
      },
      {
        "key": "typeOut",
        "type": "boolean",
        "label": "Type transcript into the focused window",
        "defaultValue": false
      },
      {
        "key": "notify",
        "type": "boolean",
        "label": "Notify on a failure the bar cannot show",
        "defaultValue": true
      },
      {
        "key": "overlay",
        "type": "boolean",
        "label": "Show the speak-now chip under the bar while recording",
        "defaultValue": true
      }
    ]
  }
}
