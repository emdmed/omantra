#!/usr/bin/env bash
# Turn a spoken instruction into one desktop action, using the local LLM.
#
#   omantra "I want to create a new project to create a todo app"
#     -> ~/projects/todo-app, git initialised, agent opened with a brief
#
# The model's only job is classification and slot-filling: it picks one action
# from a fixed list and fills typed fields. It never emits a command, so a
# misheard sentence can at worst pick the wrong action from a set that is
# entirely non-destructive — it cannot invent one.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
. "$ROOT/lib/config.sh"
. "$ROOT/lib/project.sh"
. "$ROOT/lib/theme.sh"

# ---- Actions ----------------------------------------------------------------
#
# One row per action: the name the model may return, and the sentence that
# teaches it when to pick that name. The JSON schema enum, the system prompt and
# the dispatch are all generated from this table, so adding an action is a row
# here plus a matching `do_<name>` function below — never three edits that have
# to agree.
#
# Keep them non-destructive; nothing here asks for confirmation.
ACTIONS=(
  "new_project|the user wants to start something that does not exist yet."
  "open_project|the user names an existing project to resume work on."
  "set_theme|the user wants to change how the desktop looks — its theme, its colours, light or dark — or simply names one of the installed themes listed below."
  "unknown|the instruction fits none of those, or is too vague to act on."
)

action_names() { printf '%s\n' "${ACTIONS[@]%%|*}"; }
action_help() {
  local row
  for row in "${ACTIONS[@]}"; do
    printf -- '- %s: %s\n' "${row%%|*}" "${row#*|}"
  done
}

# ---- Input ------------------------------------------------------------------

dry_run=0
if [ "${1:-}" = "--dry-run" ]; then
  dry_run=1
  shift
fi

transcript="$*"
[ -z "$transcript" ] && transcript="$(cat)"
transcript="$(printf '%s' "$transcript" | tr -s '[:space:]' ' ' | sed 's/^ //; s/ $//')"

if [ -z "$transcript" ]; then
  echo "omantra: nothing to interpret" >&2
  exit 1
fi

# Every side effect goes through run(), so exactly one place knows about
# --dry-run. open_agent() below is the one exception, because backgrounding a
# detached terminal does not survive being passed through a wrapper.
run() {
  if [ "$dry_run" = 1 ]; then
    printf 'would: %s\n' "$*"
    return 0
  fi
  "$@"
}

# Only failures notify. Everything that went right is already on screen: the
# chip under the bar is showing it, and a desktop notification for a theme
# switch you can see happening is a second copy of the news. A failure is the
# one outcome that has to outlive a chip that flashes for three seconds.
notify() { run notify-send --app-name=Omantra --icon=utilities-terminal "$1" "${2:-}"; }

die() {
  [ "$OMANTRA_NOTIFY" = true ] && notify "Omantra failed" "$1"
  echo "omantra: $1" >&2
  exit 1
}

# The one line the widget reads off stdout: what is about to happen, as the
# state word the chip shows and the subject under it. Printed *before* the side
# effect, so the chip is naming the decision while the terminal is still
# opening — the point being that a spoken command is a guess, and the guess
# should be visible.
#
# `|` separates the two, the same way the tables in this file do; no subject
# below can contain one.
plan() { printf 'plan: %s|%s\n' "$1" "${2:-}"; }

# ---- Slot filling -----------------------------------------------------------

SYSTEM="$(cat <<EOF
You convert a spoken instruction into exactly one desktop action.

Actions:
$(action_help)

Installed themes:
$(theme_names | tr '\n' ' ')

An instruction that names one of those is a theme change, whatever verb it
uses — "go back to nord" is set_theme, not open_project. A name that is not on
that list is not a theme, however much it sounds like one.

Fields:
- name: short kebab-case slug for the subject of the request. Lowercase
  letters, digits and hyphens only. Empty string when the action is unknown.
  For the project actions it names the project: "a todo app" -> "todo-app".
  For set_theme it is the theme, copied from the list above rather than
  invented — the names there are kebab-case already.
- prompt: a first instruction to hand a coding agent, written in the
  imperative and expanded into a useful brief of one or two sentences. Empty
  string for any action other than the project ones.

Reply with JSON only.
EOF
)"

# The endpoint is optional infrastructure the user starts themselves, so "not
# running" is the most likely failure here — and it used to surface only as a
# curl error at the very end, after a sentence had been recorded, transcribed
# and thrown away. Two seconds up front buys a message that names the thing to
# start.
if ! omantra_endpoint_up; then
  die "no model server at $OMANTRA_ENDPOINT — start one, e.g. llama-server --model <model>.gguf --port 8081 --jinja"
fi

request="$(jq -n \
  --arg system "$SYSTEM" \
  --arg user "$transcript" \
  --argjson actions "$(action_names | jq -R . | jq -s .)" \
  '{
    model: "local",
    temperature: 0.1,
    chat_template_kwargs: { enable_thinking: false },
    messages: [
      { role: "system", content: $system },
      { role: "user", content: $user }
    ],
    response_format: {
      type: "json_schema",
      json_schema: {
        name: "action",
        strict: true,
        schema: {
          type: "object",
          properties: {
            action: { type: "string", enum: $actions },
            name:   { type: "string" },
            prompt: { type: "string" }
          },
          required: ["action","name","prompt"],
          additionalProperties: false
        }
      }
    }
  }')"

response="$(curl -sS --max-time 120 "$OMANTRA_ENDPOINT" \
  -H 'Content-Type: application/json' \
  -d "$request")" || die "could not reach the model at $OMANTRA_ENDPOINT"

content="$(printf '%s' "$response" | jq -r '.choices[0].message.content // empty')"
[ -z "$content" ] && die "model returned no content"

action="$(printf '%s' "$content" | jq -r '.action // "unknown"')"
name="$(printf '%s' "$content" | jq -r '.name // ""')"
prompt="$(printf '%s' "$content" | jq -r '.prompt // ""')"

# The schema constrains the shape, not the contents: re-slug here so a stray
# slash or leading dot from the model can never escape $OMANTRA_PROJECTS.
slug="$(slugify "$name")"

mkdir -p "$(dirname "$OMANTRA_LOG")"
# -c matters: the file is .jsonl, and jq pretty-prints by default, so every
# entry was landing as five lines that no line-oriented reader could parse.
jq -nc --arg t "$transcript" --arg a "$action" --arg s "$slug" --arg p "$prompt" \
  '{transcript:$t, action:$a, slug:$s, prompt:$p}' >> "$OMANTRA_LOG"
if [ "$(wc -l < "$OMANTRA_LOG")" -gt "$OMANTRA_LOG_MAX_LINES" ]; then
  tail -n "$OMANTRA_LOG_MAX_LINES" "$OMANTRA_LOG" > "$OMANTRA_LOG.tmp"
  mv "$OMANTRA_LOG.tmp" "$OMANTRA_LOG"
fi

# ---- Dispatch ---------------------------------------------------------------

# Runs the agent through a login shell so it picks up mise shims from the
# profile, and drops to a shell afterwards rather than closing the window on
# exit.
open_agent() {
  local dir="$1" initial="$2" title="$3"
  if [ "$dry_run" = 1 ]; then
    printf 'would: open %s in %s with prompt: %s\n' "$OMANTRA_AGENT" "$dir" "$initial"
    return
  fi
  # shellcheck disable=SC2016  # the single quotes are the point: $1/$2/$3 are
  # the *inner* shell's positional parameters, passed after the `_` below.
  # Interpolating here would put a spoken transcript into a shell command line.
  #
  # Closing the inherited pipes matters now that the widget runs this script as
  # a tracked process: a backgrounded terminal holding stdout open keeps the
  # widget's collector waiting for EOF long after the script itself is gone.
  setsid xdg-terminal-exec --title="$title" -- \
    bash -lc 'cd "$1" && "$2" "$3"; exec bash -l' _ "$dir" "$OMANTRA_AGENT" "$initial" \
    >/dev/null 2>&1 &
}

do_new_project() {
  [ -z "$slug" ] && die "could not name a project from: $transcript"
  local dir="$OMANTRA_PROJECTS/$slug"

  # The agent is named in the plan because it is the part that isn't obvious:
  # which project got picked is a guess about what was said, and which command
  # opens it is a setting the user may have changed since.
  if [ -d "$dir" ]; then
    plan "OPEN" "$slug · $OMANTRA_AGENT"
  else
    plan "NEW PROJECT" "$slug · $OMANTRA_AGENT"
    run mkdir -p "$dir"
    run git -C "$dir" init -q
  fi

  open_agent "$dir" "$prompt" "$OMANTRA_AGENT: $slug"
}

do_open_project() {
  [ -z "$slug" ] && die "no project named in: $transcript"
  local match
  match="$(find_project "$slug")" \
    || die "nothing in $OMANTRA_PROJECTS matches \"$slug\""
  plan "OPEN" "$match · $OMANTRA_AGENT"
  open_agent "$OMANTRA_PROJECTS/$match" "$prompt" "$OMANTRA_AGENT: $match"
}

do_set_theme() {
  [ -z "$slug" ] && die "no theme named in: $transcript"
  command -v omarchy-theme-set >/dev/null \
    || die "omarchy-theme-set is not on PATH — theme switching needs Omarchy"

  local match
  match="$(find_theme "$slug")" \
    || die "no installed theme matches \"$(theme_title "$slug")\""

  # The desktop repainting is its own confirmation, so the plan only has to name
  # what was picked — which is the part worth seeing when speech was approximate
  # and the match widened to a substring.
  plan "THEME" "$(theme_title "$match")"
  run omarchy-theme-set "$match"
}

# Not understood is not a failure — hand the words back so the take is not
# lost, and let the user decide what to do with them.
do_unknown() {
  plan "NOT UNDERSTOOD" "copied to the clipboard"
  run wl-copy -- "$transcript"
  exit 0
}

# A model that returns something off the table is treated as `unknown` rather
# than as an error: the words still reach the clipboard.
if declare -F "do_$action" >/dev/null; then
  "do_$action"
else
  do_unknown
fi
