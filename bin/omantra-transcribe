#!/usr/bin/env bash
# Local English speech-to-text: sherpa-onnx + NVIDIA Parakeet TDT 0.6B v2 (int8).
# Usage: omantra-transcribe <audio-file> [--json]
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
. "$ROOT/lib/config.sh"

if [ $# -lt 1 ]; then
  echo "usage: omantra-transcribe <audio-file> [--json]" >&2
  exit 1
fi

if [ ! -x "$OMANTRA_SHERPA_BIN/sherpa-onnx-offline" ]; then
  echo "omantra-transcribe: sherpa-onnx not found at $OMANTRA_SHERPA_BIN — run omantra-fetch" >&2
  exit 1
fi

# What the model needs on disk, and which of it is absent — asked through the
# same table that builds the command line below, so this cannot approve a model
# the decoder then fails to open.
if ! asr_ready "$OMANTRA_ASR_PROFILE"; then
  echo "omantra-transcribe: $OMANTRA_ASR_PROFILE is not fully downloaded — run omantra-fetch" >&2
  while IFS= read -r f; do
    [ -f "$f" ] || echo "  missing: $f" >&2
  done < <(asr_files "$OMANTRA_ASR_PROFILE")
  exit 1
fi

input=$1
json=${2:-}

if [ ! -f "$input" ]; then
  echo "omantra-transcribe: no such file: $input" >&2
  exit 1
fi

# Parakeet wants 16 kHz mono 16-bit PCM; let ffmpeg handle anything else.
wav=$(mktemp --suffix=.wav)
err=$(mktemp)
trap 'rm -f "$wav" "$err"' EXIT

if ! ffmpeg -v error -y -i "$input" -ac 1 -ar 16000 -sample_fmt s16 "$wav" 2>"$err"; then
  echo "omantra-transcribe: could not decode $input" >&2
  cat "$err" >&2
  exit 1
fi

# sherpa's own diagnostics go to stderr and its result to stdout. Keeping the
# stderr rather than discarding it is the difference between "the model file is
# truncated" and an empty failure the widget reports as `exit 1`.
# The model half of the command line comes from the profile: a NeMo transducer
# and a Whisper export do not take the same flags, and this is the one place
# that difference is allowed to exist.
mapfile -t model_flags < <(asr_args "$OMANTRA_ASR_PROFILE")

if ! raw=$("$OMANTRA_SHERPA_BIN/sherpa-onnx-offline" \
  "${model_flags[@]}" \
  --num-threads="$OMANTRA_THREADS" \
  "$wav" 2>"$err"); then
  echo "omantra-transcribe: sherpa-onnx failed" >&2
  cat "$err" >&2
  exit 1
fi

out=$(printf '%s\n' "$raw" | grep -E '^\{' || true)
if [ -z "$out" ]; then
  echo "omantra-transcribe: no result in sherpa-onnx output" >&2
  cat "$err" >&2
  exit 1
fi

if [ "$json" = "--json" ]; then
  echo "$out"
else
  echo "$out" | jq -r .text
fi
